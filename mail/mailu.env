# Mailu configuration
# Copy to .env and edit before starting: cp mailu.env .env
# Docs: https://mailu.io/2.0/configuration.html

# === Compose / paths ===
ROOT=./data
BIND_ADDRESS4=127.0.0.1

# === Core ===
# Generate with: pwgen 16 1
SECRET_KEY=change-me-16-chars
DOMAIN=akarigear.com
HOSTNAMES=mail.akarigear.com
SUBNET=192.168.203.0/24
POSTMASTER=admin

# === TLS ===
# notls = testing only | cert = manual | letsencrypt = auto
TLS_FLAVOR=notls

# === Web ===
WEB_ADMIN=/admin
WEB_WEBMAIL=/webmail
WEB_API=/api
WEBROOT_REDIRECT=/webmail
SITENAME=Mousepad Mail
WEBSITE=
# Required for HTTP (notls) - allow non-secure cookies
SESSION_COOKIE_SECURE=False

# === Features ===
WEBMAIL=roundcube

# === Admin (auto-create first admin) ===
INITIAL_ADMIN_ACCOUNT=admin
INITIAL_ADMIN_DOMAIN=akarigear.com
INITIAL_ADMIN_PW=ChangeMe123!
INITIAL_ADMIN_MODE=ifmissing

# === Mail settings ===
MESSAGE_SIZE_LIMIT=50000000

# === Security / limits ===
AUTH_RATELIMIT_IP=5/hour
AUTH_RATELIMIT_USER=50/day
MESSAGE_RATELIMIT=200/day

# === Feature flags (required by nginx) ===
ADMIN=true
API=true

# === Optional: Backend SMTP for Mousepad ===
# Create a mailbox (e.g. noreply@akarigear.com) in admin UI, then set in backend .env:
# SMTP_HOST=<your-server>
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=<mailbox-password>

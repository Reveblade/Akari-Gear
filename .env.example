# Server
NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/mousepad-store

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Email (for verification & password reset)
# Use Mailtrap, SendGrid, or SMTP for development
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-mailtrap-user
SMTP_PASS=your-mailtrap-pass
EMAIL_FROM=noreply@mousepad-store.com

# Exchange rate cron (default: weekdays 16:00)
# CRON_EXCHANGE_RATE=0 16 * * 1-5

# Frontend URLs (for email links)
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

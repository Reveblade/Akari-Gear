# Server
NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/mousepad-store

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Email (Resend - for verification, password reset, 2FA codes)
# Create API key at https://resend.com/api-keys
RESEND_API_KEY=re_your-api-key
EMAIL_FROM=onboarding@resend.dev

# Exchange rate cron (default: weekdays 16:00)
# CRON_EXCHANGE_RATE=0 16 * * 1-5

# Frontend URLs (for email links)
FRONTEND_URL=http://localhost:8000
ADMIN_URL=http://localhost:8001
